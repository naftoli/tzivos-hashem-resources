DirectoryIndex index.html dist/index.html
RewriteEngine On
RewriteBase /resources/site/

# /resources/site/dist/ is a real directory. Options -Indexes plus the
# DirectoryIndex of dist/index.html (meant for /resources/site/) looks for
# dist/dist/index.html and Apache returns 403. Serve the built index instead.
RewriteRule ^dist/?$ dist/index.html [L]
RewriteRule ^dist/ - [L]

# /resources/site and /resources/site/index.html are the Vite *source* shell
# (it loads /src/main.tsx, which Apache cannot compile). Serve the build.
RewriteRule ^$ dist/index.html [L]
RewriteRule ^index\.html$ dist/index.html [L]
